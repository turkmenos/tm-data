{
  "version": 1,
  "datasets": [
    {
      "path": "language/morphology/suffixes.json",
      "required": {
        "id": "string",
        "pos": "string",
        "slot": "number",
        "features": "object",
        "harmony": "string",
        "variants": "array",
        "requires_previous": "array",
        "excludes": "array",
        "verification_status": "string",
        "references": "array"
      },
      "non_empty": [
        "id",
        "pos",
        "harmony",
        "verification_status"
      ],
      "unique": [
        [
          "id"
        ]
      ],
      "allowed_values": {
        "verification_status": [
          "source_checked"
        ],
        "pos": [
          "noun",
          "verb"
        ]
      }
    },
    {
      "path": "language/morphology/rules.json",
      "required": {
        "id": "string",
        "kind": "string",
        "description": "string",
        "parameters": "object",
        "verification_status": "string",
        "references": "array"
      },
      "non_empty": [
        "id",
        "kind",
        "description",
        "verification_status"
      ],
      "unique": [
        [
          "id"
        ]
      ],
      "allowed_values": {
        "verification_status": [
          "source_checked"
        ]
      }
    },
    {
      "path": "language/morphology/examples.json",
      "required": {
        "id": "string",
        "word": "string",
        "root": "string",
        "stem": "string",
        "pos": "string",
        "segments": "array",
        "meaning_en": "string",
        "exception_ids": "array",
        "verification_status": "string",
        "references": "array"
      },
      "non_empty": [
        "id",
        "word",
        "root",
        "stem",
        "pos",
        "meaning_en",
        "verification_status"
      ],
      "unique": [
        [
          "id"
        ]
      ],
      "allowed_values": {
        "verification_status": [
          "attested",
          "rule_checked"
        ],
        "pos": [
          "noun",
          "verb"
        ]
      }
    },
    {
      "path": "language/morphology/exceptions.json",
      "required": {
        "id": "string",
        "kind": "string",
        "root": "string",
        "stem": "string",
        "pos": "string",
        "trigger": "string",
        "suffix_ids": "array",
        "example_word": "string",
        "note": "string",
        "verification_status": "string",
        "references": "array"
      },
      "non_empty": [
        "id",
        "kind",
        "root",
        "stem",
        "pos",
        "trigger",
        "example_word",
        "note",
        "verification_status"
      ],
      "unique": [
        [
          "id"
        ]
      ],
      "allowed_values": {
        "verification_status": [
          "source_checked"
        ],
        "pos": [
          "noun",
          "verb"
        ]
      }
    },
    {
      "path": "language/morphology/sources.json",
      "required": {
        "id": "string",
        "title": "string",
        "creator": "string",
        "url": "string",
        "accessed_on": "string",
        "rights": "string",
        "note": "string"
      },
      "non_empty": [
        "id",
        "title",
        "creator",
        "url",
        "accessed_on",
        "rights",
        "note"
      ],
      "unique": [
        [
          "id"
        ]
      ]
    },
    {
      "path": "utils/calendar/months.json",
      "required": { "number": "number", "tm": "string", "en": "string" },
      "non_empty": ["tm", "en"],
      "unique": [["number"], ["tm"], ["en"]],
      "ranges": { "number": { "min": 1, "max": 12 } }
    },
    {
      "path": "utils/calendar/weekdays.json",
      "required": { "iso": "number", "tm": "string", "en": "string" },
      "non_empty": ["tm", "en"],
      "unique": [["iso"], ["tm"], ["en"]],
      "ranges": { "iso": { "min": 1, "max": 7 } }
    },
    {
      "path": "utils/calendar/seasons.json",
      "required": { "id": "string", "tm": "string", "en": "string" },
      "non_empty": ["id", "tm", "en"],
      "unique": [["id"], ["tm"], ["en"]]
    },
    {
      "path": "utils/calendar/day-periods.json",
      "required": { "id": "string", "tm": "string", "en": "string" },
      "non_empty": ["id", "tm", "en"],
      "unique": [["id"], ["tm"], ["en"]]
    },
    {
      "path": "utils/calendar/time-units.json",
      "required": { "id": "string", "tm": "string", "en": "string" },
      "non_empty": ["id", "tm", "en"],
      "unique": [["id"], ["tm"], ["en"]]
    },
    {
      "path": "utils/country-names/countries.json",
      "required": { "code": "string", "tm": "string", "en": "string" },
      "non_empty": ["code", "tm", "en"],
      "unique": [["code"], ["tm"], ["en"]]
    },
    {
      "path": "utils/holidays/holidays.json",
      "required": { "name": "string", "type": "string", "day_off": "boolean" },
      "non_empty": ["name", "type"],
      "unique": [["name"]],
      "allowed_values": { "type": ["public_holiday", "observance"] },
      "ranges": { "month": { "min": 1, "max": 12 }, "day": { "min": 1, "max": 31 }, "start_day": { "min": 1, "max": 31 }, "end_day": { "min": 1, "max": 31 } },
      "any_required": [["month", "rule"], ["day", "rule", "start_day"]]
    },
    {
      "path": "utils/names/man-names.json",
      "required": { "name": "string", "description": "string" },
      "non_empty": ["name"],
      "unique": [["name"]]
    },
    {
      "path": "utils/names/woman-names.json",
      "required": { "name": "string", "description": "string" },
      "non_empty": ["name"],
      "unique": [["name"]]
    },
    {
      "path": "utils/names/unisex-names.json",
      "required": { "name": "string", "description": "string" },
      "non_empty": ["name"],
      "unique": [["name"]]
    },
    {
      "path": "utils/riddles/riddles.json",
      "required": { "id": "string", "text": "string", "answer": "string", "category": "string", "source_id": "string", "verification_status": "string" },
      "non_empty": ["id", "text", "answer", "category", "source_id", "verification_status"],
      "unique": [["id"], ["text"]],
      "allowed_values": {
        "category": ["asman", "tebigat", "esbaplar", "wagt", "ses"],
        "verification_status": ["unreviewed"]
      }
    },
    {
      "path": "utils/riddles/sources.json",
      "required": { "id": "string", "type": "string", "title": "string", "creator": "string", "rights": "string", "note": "string" },
      "non_empty": ["id", "type", "title", "creator", "rights", "note"],
      "unique": [["id"]],
      "allowed_values": { "type": ["original", "publication", "oral_recording", "website"] },
      "ranges": { "created_year": { "min": 1900, "max": 2100 } }
    },
    {
      "path": "utils/postal-codes/regions.json",
      "required": { "iso": "string", "level": "string", "type": "string", "name": "string", "iso2": "string" },
      "non_empty": ["iso", "level", "type", "name"],
      "unique": [["level", "region1", "name"]]
    },
    {
      "path": "utils/postal-codes/places.json",
      "required": { "id": "string", "iso": "string", "region1": "string", "locality": "string", "iso2": "string", "latitude": "string", "longitude": "string" },
      "non_empty": ["id", "iso", "region1", "locality", "iso2", "latitude", "longitude"],
      "unique": [["id"]]
    },
    {
      "path": "utils/colors/colors.json",
      "required": { "id": "number", "name_tm": "string", "category": "string" },
      "non_empty": ["name_tm", "category"],
      "unique": [["id"], ["name_tm"]],
      "allowed_values": { "category": ["basic", "shade", "metallic", "modifier", "pattern"] }
    },
    {
      "path": "geo/json/region_types.json",
      "required": { "type": "string", "description": "string" },
      "non_empty": ["type", "description"],
      "unique": [["type"]]
    },
    {
      "path": "geo/json/regions.json",
      "required": { "slug": "string", "name_tm": "string", "name_en": "string", "type": "string", "country_code": "string", "verification_status": "string" },
      "non_empty": ["slug", "name_tm", "name_en", "type", "country_code", "verification_status"],
      "unique": [["slug"]],
      "allowed_values": {
        "type": ["country", "independent_city", "welayat", "etrap", "city", "town", "village", "rural_council"],
        "verification_status": ["verified", "verification_required"]
      }
    },
    {
      "path": "geo/json/region_aliases.json",
      "required": { "region_slug": "string", "alias": "string", "language": "string", "alias_type": "string", "normalized_alias": "string" },
      "non_empty": ["region_slug", "alias", "language", "alias_type", "normalized_alias"],
      "unique": [["region_slug", "alias"]],
      "allowed_values": { "alias_type": ["canonical", "transliteration", "ascii", "historical"] }
    }
  ],
  "references": [
    {
      "from_path": "utils/postal-codes/places.json",
      "from_field": "iso2",
      "to_path": "utils/postal-codes/regions.json",
      "to_field": "iso2"
    },
    {
      "from_path": "geo/json/region_aliases.json",
      "from_field": "region_slug",
      "to_path": "geo/json/regions.json",
      "to_field": "slug"
    },
    {
      "from_path": "geo/json/regions.json",
      "from_field": "parent_slug",
      "to_path": "geo/json/regions.json",
      "to_field": "slug"
    },
    {
      "from_path": "utils/riddles/riddles.json",
      "from_field": "source_id",
      "to_path": "utils/riddles/sources.json",
      "to_field": "id"
    }
  ]
}
